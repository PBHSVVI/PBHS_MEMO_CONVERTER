{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbhs.example/contracts/job.schema.json",
  "title": "Memo Builder Job Contract",
  "type": "object",
  "required": [
    "id",
    "user_id",
    "status",
    "stage",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "queued",
        "dispatched",
        "processing",
        "needs_review",
        "correction_pending",
        "correction_confirmed",
        "rendering",
        "complete",
        "failed_retryable",
        "failed"
      ]
    },
    "stage": {
      "type": "string"
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_mime": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_required": {
      "type": "boolean"
    },
    "document_schema_version": {
      "type": "string"
    },
    "render_profile": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "teacher_metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "values",
        "confirmed_absent"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "values": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "paper": {
              "type": "string",
              "enum": [
                "PAPER 1",
                "PAPER 2"
              ]
            },
            "exam_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "grade_label": {
              "type": "string",
              "pattern": "^(FORM|GRADE) ([1-9]|1[0-3])$"
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            }
          },
          "additionalProperties": false
        },
        "confirmed_absent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "subject",
              "paper",
              "exam_type",
              "year",
              "grade_label",
              "duration_minutes"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "teacher_metadata_revision": {
      "type": "integer",
      "minimum": 0
    },
    "teacher_metadata_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
